<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.SanctionPage"
             Title="SanctionPage">

    <Grid RowDefinitions="*" VerticalOptions="Fill">

        <ScrollView Grid.Row="0" VerticalOptions="Fill">

            <VerticalStackLayout Padding="10">

                <Label Text="Выберите команду:" Margin="5,0,0,0"/>
                <Picker x:Name="PickerTeams" Margin="0,10,0,15" ItemDisplayBinding="{Binding Name}"  SelectedIndexChanged="OnTeamsChanged"/>

                <Label Text="Выберите уровень санкции:" Margin="5,0,0,0"/>
                <Picker x:Name="PickerSanction" Margin="0,10,0,15"/>

                <Label Text="Выберите для кого санкция (команда, тренер, игрок):" Margin="5,0,0,0"/>
                <Picker x:Name="PickerPTC" Margin="0,10,0,15" ItemDisplayBinding="{Binding Number}"/>

                <Button Clicked="OnSaveButtonClick" Text="Сохранить" TextColor="White" VerticalOptions="Start" Margin="20,70,20,20">

                    <VisualStateManager.VisualStateGroups>

                        <VisualStateGroupList>

                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal">

                                    <VisualState.Setters>

                                        <Setter Property="Background" Value="{DynamicResource MainColor}"/>

                                    </VisualState.Setters>

                                </VisualState>

                                <VisualState x:Name="PointerOver">

                                    <VisualState.Setters>

                                        <Setter Property="Background" Value="{DynamicResource PointColor}"/>

                                    </VisualState.Setters>

                                </VisualState>

                            </VisualStateGroup>

                        </VisualStateGroupList>

                    </VisualStateManager.VisualStateGroups>

                </Button>

                <Button Clicked="OnExitButtonClick" Text="Отмена" TextColor="White" VerticalOptions="Center" Margin="20,10,20,20">

                    <VisualStateManager.VisualStateGroups>

                        <VisualStateGroupList>

                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal">

                                    <VisualState.Setters>

                                        <Setter Property="Background" Value="{DynamicResource ExitColor}"/>

                                    </VisualState.Setters>

                                </VisualState>

                                <VisualState x:Name="PointerOver">

                                    <VisualState.Setters>

                                        <Setter Property="Background" Value="{DynamicResource PointExitColor}"/>

                                    </VisualState.Setters>

                                </VisualState>

                            </VisualStateGroup>

                        </VisualStateGroupList>

                    </VisualStateManager.VisualStateGroups>

                </Button>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
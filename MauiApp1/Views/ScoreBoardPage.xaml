
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.ScoreBoardPage"
             Title="Игра">

    <Grid RowDefinitions="2*, 5*, 3*" 
          Padding="10"
          RowSpacing="10">

        <!-- ВЕРХНЯЯ ЧАСТЬ: ПАРТИИ И НАЗВАНИЯ -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto, Auto, *" RowDefinitions="auto" VerticalOptions="Start">

            <Border Grid.Column="0" StrokeShape="RoundRectangle 15" Margin="0,0,50,0">
                
                <Label x:Name="NameLeft"                        
                       FontSize="Title" 
                       TextColor="White" 
                       VerticalOptions="Center" 
                       HorizontalOptions="Center">
                </Label>
                
            </Border>
            
            <Label x:Name="CountSetLeft" 
                   Grid.Column="1" 
                   FontSize="Title" 
                   FontAttributes="Bold" 
                   TextColor="White" 
                   VerticalTextAlignment="Center"
                   Margin="0,0,30,0">
            </Label>

            <Label Grid.Column="2" Text=":" VerticalOptions="Center" FontSize="Title"/>

            <Label x:Name="CountSetRight"
                   Grid.Column="3" 
                   FontSize="Title" 
                   FontAttributes="Bold" 
                   TextColor="White" 
                   VerticalTextAlignment="Center"
                   Margin="30,0,0,0">
            </Label>
            
            <Border Grid.Column="4" StrokeShape="RoundRectangle 15" Margin="50,0,0,0">
                <Label x:Name="NameRight"                    
                       FontSize="Title" 
                       TextColor="White" 
                       VerticalOptions="Center" 
                       HorizontalOptions="Center">
                </Label>
            </Border>

        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*, auto, *" RowDefinitions="*">

            <Button Grid.Column="0" 
                    x:Name="ScoreLeftButton"
                    Clicked="OnScoreLeftClick"
                    Text="0"
                    TextColor="White"
                    FontSize="52" 
                    Margin="0,0,30,0">

                <VisualStateManager.VisualStateGroups>
                    
                    <VisualStateGroupList>
                        
                        <VisualStateGroup x:Name="CommonStates">
                            
                            <VisualState x:Name="Normal">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource MainColorLeft}"/>

                                </VisualState.Setters>
                                
                            </VisualState>

                            <VisualState x:Name="PointerOver">
                                
                                <VisualState.Setters>
                                    
                                    <Setter Property="Background" Value="{DynamicResource PointColorLeft}"/>
                                    
                                </VisualState.Setters>
                                
                            </VisualState>

                        </VisualStateGroup>
                        
                    </VisualStateGroupList>
                    
                </VisualStateManager.VisualStateGroups>
                
            </Button>

            <Grid Grid.Column="1" RowDefinitions="*,*">

                <Button Grid.Row="0" 
                    Text="Смена" 
                    FontAttributes="Bold"
                    Clicked="OnReverseClick"
                    VerticalOptions="End"
                    HorizontalOptions="Fill"    
                    TextColor="White" 
                    Margin="5,0,5,0">

                    <VisualStateManager.VisualStateGroups>

                        <VisualStateGroupList>

                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal">

                                    <VisualState.Setters>

                                        <Setter Property="Background" Value="{DynamicResource MainColor}"/>

                                    </VisualState.Setters>

                                </VisualState>

                                <VisualState x:Name="PointerOver">

                                    <VisualState.Setters>

                                        <Setter Property="Background" Value="{DynamicResource PointColor}"/>

                                    </VisualState.Setters>

                                </VisualState>

                            </VisualStateGroup>

                        </VisualStateGroupList>

                    </VisualStateManager.VisualStateGroups>
                    
                </Button>

                <Button Grid.Row="1" 
                    x:Name="ButtonCancelScore" 
                    Text="Вернуть очко"
                    Clicked="OnCancelScoreClick"
                    FontAttributes="Bold"
                    TextColor="White"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    Margin="5,0,5,0">

                    <VisualStateManager.VisualStateGroups>

                        <VisualStateGroupList>

                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal">

                                    <VisualState.Setters>

                                        <Setter Property="Background" Value="{DynamicResource MainColor}"/>

                                    </VisualState.Setters>

                                </VisualState>

                                <VisualState x:Name="PointerOver">

                                    <VisualState.Setters>

                                        <Setter Property="Background" Value="{DynamicResource PointColor}"/>

                                    </VisualState.Setters>

                                </VisualState>

                            </VisualStateGroup>

                        </VisualStateGroupList>

                    </VisualStateManager.VisualStateGroups>

                </Button>
                
            </Grid>            
            
            <Button Grid.Column="2" 
                    x:Name="ScoreRightButton"
                    Clicked="OnScoreRightClick"
                    Text="0"
                    TextColor="White"
                    FontSize="52" 
                    Margin="30,0,0,0">

                <VisualStateManager.VisualStateGroups>

                    <VisualStateGroupList>

                        <VisualStateGroup x:Name="CommonStates">

                            <VisualState x:Name="Normal">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource MainColorRight}"/>

                                </VisualState.Setters>

                            </VisualState>

                            <VisualState x:Name="PointerOver">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource PointColorRight}"/>

                                </VisualState.Setters>

                            </VisualState>

                        </VisualStateGroup>

                    </VisualStateGroupList>

                </VisualStateManager.VisualStateGroups>
                
            </Button>

        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="10*, 7*, 7*, 7*, 7*, 10*" RowDefinitions="*">

            <Button Grid.Row="1" 
                    Grid.Column="0" 
                    x:Name="LineUpLeftButton"
                    Clicked="OnNowLineUpLeftClick"
                    VerticalOptions="Center"
                    TextColor="White"
                    Margin="0,0,10,0" 
                    Text="Текущая расстановка"
                    FontAttributes="Bold"
                    MinimumHeightRequest="80">

                <VisualStateManager.VisualStateGroups>

                    <VisualStateGroupList>

                        <VisualStateGroup x:Name="CommonStates">

                            <VisualState x:Name="Normal">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource MainColorLeft}"/>

                                </VisualState.Setters>

                            </VisualState>

                            <VisualState x:Name="PointerOver">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource PointColorLeft}"/>

                                </VisualState.Setters>

                            </VisualState>

                        </VisualStateGroup>

                    </VisualStateGroupList>

                </VisualStateManager.VisualStateGroups>
                
            </Button>

            <Button Grid.Row="1" 
                    Grid.Column="1" 
                    VerticalOptions="Center"
                    x:Name="TimeOutLeftButton"
                    Clicked="OnTimeOutLeftClick"
                    TextColor="White"
                    Margin="0,0,10,0" 
                    Text="Таймауты"
                    FontAttributes="Bold"
                    MinimumHeightRequest="80">

                <VisualStateManager.VisualStateGroups>

                    <VisualStateGroupList>

                        <VisualStateGroup x:Name="CommonStates">

                            <VisualState x:Name="Normal">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource MainColorLeft}"/>

                                </VisualState.Setters>

                            </VisualState>

                            <VisualState x:Name="PointerOver">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource PointColorLeft}"/>

                                </VisualState.Setters>

                            </VisualState>

                            <VisualState x:Name="Disabled">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="Gray"/>

                                </VisualState.Setters>

                            </VisualState>

                        </VisualStateGroup>

                    </VisualStateGroupList>

                </VisualStateManager.VisualStateGroups>

            </Button>

            <Button Grid.Row="1" 
                    Grid.Column="2" 
                    VerticalOptions="Center"
                    x:Name="ReplaceLeftButton"
                    Clicked="OnReplaceLeftClick"
                    TextColor="White"
                    Margin="0,0,30,0" 
                    Text="Замены"
                    FontAttributes="Bold"
                    MinimumHeightRequest="80">

                <VisualStateManager.VisualStateGroups>

                    <VisualStateGroupList>

                        <VisualStateGroup x:Name="CommonStates">

                            <VisualState x:Name="Normal">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource MainColorLeft}"/>

                                </VisualState.Setters>

                            </VisualState>

                            <VisualState x:Name="PointerOver">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource PointColorLeft}"/>

                                </VisualState.Setters>

                            </VisualState>

                            <VisualState x:Name="Disabled">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="Gray"/>

                                </VisualState.Setters>

                            </VisualState>

                        </VisualStateGroup>

                    </VisualStateGroupList>

                </VisualStateManager.VisualStateGroups>

            </Button>

            <Button Grid.Row="1" 
                    Grid.Column="3" 
                    VerticalOptions="Center"
                    x:Name="ReplaceRightButton"
                    Clicked="OnReplaceRightClick"
                    TextColor="White"
                    Margin="30,0,0,0" 
                    Text="Замены"
                    FontAttributes="Bold"
                    MinimumHeightRequest="80">

                <VisualStateManager.VisualStateGroups>

                    <VisualStateGroupList>

                        <VisualStateGroup x:Name="CommonStates">

                            <VisualState x:Name="Normal">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource MainColorRight}"/>

                                </VisualState.Setters>

                            </VisualState>

                            <VisualState x:Name="PointerOver">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource PointColorRight}"/>

                                </VisualState.Setters>

                            </VisualState>

                            <VisualState x:Name="Disabled">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="Gray"/>

                                </VisualState.Setters>

                            </VisualState>

                        </VisualStateGroup>

                    </VisualStateGroupList>

                </VisualStateManager.VisualStateGroups>

            </Button>

            <Button Grid.Row="1" 
                    Grid.Column="4" 
                    VerticalOptions="Center"
                    x:Name="TimeOutRightButton"
                    Clicked="OnTimeOutRightClick"
                    TextColor="White"
                    Margin="10,0,0,0" 
                    Text="Таймауты"
                    FontAttributes="Bold"
                    MinimumHeightRequest="80">

                <VisualStateManager.VisualStateGroups>

                    <VisualStateGroupList>

                        <VisualStateGroup x:Name="CommonStates">

                            <VisualState x:Name="Normal">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource MainColorRight}"/>

                                </VisualState.Setters>

                            </VisualState>

                            <VisualState x:Name="PointerOver">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource PointColorRight}"/>

                                </VisualState.Setters>

                            </VisualState>

                            <VisualState x:Name="Disabled">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="Gray"/>

                                </VisualState.Setters>

                            </VisualState>

                        </VisualStateGroup>

                    </VisualStateGroupList>

                </VisualStateManager.VisualStateGroups>

            </Button>

            <Button Grid.Row="1" 
                    Grid.Column="5" 
                    VerticalOptions="Center"
                    x:Name="LineUpRightButton"
                    Clicked="OnNowLineUpRightClick"
                    TextColor="White"
                    Margin="10,0,0,0" 
                    Text="Текущая расстановка"
                    FontAttributes="Bold"
                    MinimumHeightRequest="80">

                <VisualStateManager.VisualStateGroups>

                    <VisualStateGroupList>

                        <VisualStateGroup x:Name="CommonStates">

                            <VisualState x:Name="Normal">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource MainColorRight}"/>

                                </VisualState.Setters>

                            </VisualState>

                            <VisualState x:Name="PointerOver">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource PointColorRight}"/>

                                </VisualState.Setters>

                            </VisualState>

                        </VisualStateGroup>

                    </VisualStateGroupList>

                </VisualStateManager.VisualStateGroups>
                
            </Button>

        </Grid>
        
    </Grid>
    
</ContentPage>
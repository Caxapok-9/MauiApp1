<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.HistoryPage"
             Title="HistoryPage">

    <Grid RowDefinitions="*,auto" HorizontalOptions="Fill">
        
        <CollectionView x:Name="CollectionHistory" SelectionMode="None" Grid.Row="0" Margin="25">
        
            <CollectionView.ItemTemplate>
            
                <DataTemplate>

                    <Label Grid.Column="1" 
                        Text="{Binding .}" 
                        LineBreakMode="WordWrap" 
                        TextColor="White"
                        VerticalOptions="Start"/>

                </DataTemplate>
            
            </CollectionView.ItemTemplate>
        
        </CollectionView>

        <Button     
            Grid.Row="1"
            x:Name="BackButton"
            Text="Вернуться"
            VerticalOptions="Start"
            Margin="10"
            TextColor="White"
            FontAttributes="Bold"
            Clicked="OnExitClick">

            <VisualStateManager.VisualStateGroups>

                <VisualStateGroupList>

                    <VisualStateGroup x:Name="CommonStates">

                        <VisualState x:Name="Normal">

                            <VisualState.Setters>

                                <Setter Property="Background" Value="{DynamicResource ExitColor}"/>

                            </VisualState.Setters>

                        </VisualState>

                        <VisualState x:Name="PointerOver">

                            <VisualState.Setters>

                                <Setter Property="Background" Value="{DynamicResource PointExitColor}"/>

                            </VisualState.Setters>

                        </VisualState>

                    </VisualStateGroup>

                </VisualStateGroupList>

            </VisualStateManager.VisualStateGroups>

        </Button>

    </Grid>

</ContentPage>
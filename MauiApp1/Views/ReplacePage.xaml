
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.ReplacePage"
             Title="ReplacePage">

    <Grid ColumnDefinitions="*,*,*" RowDefinitions="auto,*">

        <Label Grid.Column="0" Grid.Row="0" Text="Игроки на поле" FontSize="Title" Margin="0,15,0,0" HorizontalOptions="Center" VerticalOptions="Start" FontAttributes="Bold" TextColor="White"/>

        <Border Grid.Column="0" Grid.Row="1" Stroke="{DynamicResource MainColor}" Background="Transparent" Padding="5" Margin="15">

            <Border.StrokeShape>

                <RoundRectangle CornerRadius="10"/>

            </Border.StrokeShape>

            <CollectionView x:Name="ListPlayerIn" SelectionMode="Single" ItemSizingStrategy="MeasureFirstItem">

                <CollectionView.ItemsLayout>

                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="5"/>

                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border Stroke="{DynamicResource MainColor}">

                            <VisualStateManager.VisualStateGroups>

                                <VisualStateGroupList>

                                    <VisualStateGroup x:Name="CommonStates">

                                        <VisualState x:Name="Normal">

                                            <VisualState.Setters>

                                                <Setter Property="Background" Value="#141414"/>

                                            </VisualState.Setters>

                                        </VisualState>

                                        <VisualState x:Name="Selected">

                                            <VisualState.Setters>

                                                <Setter Property="Background" Value="{DynamicResource PointColor}"/>

                                            </VisualState.Setters>

                                        </VisualState>

                                    </VisualStateGroup>

                                </VisualStateGroupList>

                            </VisualStateManager.VisualStateGroups>

                            <Border.StrokeShape>

                                <RoundRectangle CornerRadius="10"/>

                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="auto,*" Margin="4" VerticalOptions="Center">

                                <Label Grid.Column="0" Text="{Binding Number}" Margin="10,5,10,5" VerticalOptions="Center" HorizontalOptions="Center" FontSize="Subtitle"/>
                                <Label Grid.Column="1" Text="{Binding Name}" Margin="10,5,0,5" VerticalOptions="Center" HorizontalOptions="Start" FontSize="Subtitle"/>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>
            
        </Border>

        <Label Grid.Column="1" Grid.Row="0" Text="Игроки на замене" FontSize="Title" Margin="0,15,0,0" HorizontalOptions="Center" VerticalOptions="Start" FontAttributes="Bold" TextColor="White"/>

        <Border Grid.Column="1" Grid.Row="1" Stroke="{DynamicResource ExitColor}" Background="Transparent" Padding="5" Margin="15">

            <Border.StrokeShape>

                <RoundRectangle CornerRadius="10"/>

            </Border.StrokeShape>

            <CollectionView x:Name="ListPlayerOut" SelectionMode="Single" ItemSizingStrategy="MeasureFirstItem">

                <CollectionView.ItemsLayout>

                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="5"/>

                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border Stroke="{DynamicResource ExitColor}">

                            <VisualStateManager.VisualStateGroups>

                                <VisualStateGroupList>

                                    <VisualStateGroup x:Name="CommonStates">

                                        <VisualState x:Name="Normal">

                                            <VisualState.Setters>

                                                <Setter Property="Background" Value="#141414"/>

                                            </VisualState.Setters>

                                        </VisualState>

                                        <VisualState x:Name="Selected">

                                            <VisualState.Setters>

                                                <Setter Property="Background" Value="{DynamicResource PointExitColor}"/>

                                            </VisualState.Setters>

                                        </VisualState>

                                    </VisualStateGroup>

                                </VisualStateGroupList>

                            </VisualStateManager.VisualStateGroups>

                            <Border.StrokeShape>

                                <RoundRectangle CornerRadius="10"/>

                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="auto,*" Margin="4" VerticalOptions="Center">

                                <Label Grid.Column="0" Text="{Binding Number}" Margin="10,5,10,5" VerticalOptions="Center" HorizontalOptions="Center" FontSize="Subtitle"/>
                                <Label Grid.Column="1" Text="{Binding Name}" Margin="10,5,0,5" VerticalOptions="Center" HorizontalOptions="Start" FontSize="Subtitle"/>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </Border>

        <Grid Grid.Column="2" Grid.Row="1" VerticalOptions="Start" RowDefinitions="*,*">

            <Button Grid.Row="0" x:Name="ButtonReplace" Clicked="OnReplaceButtonClick" Text="Замена" TextColor="White" VerticalOptions="Start" Margin="20,70,20,20">

                <VisualStateManager.VisualStateGroups>

                    <VisualStateGroupList>

                        <VisualStateGroup x:Name="CommonStates">

                            <VisualState x:Name="Normal">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource MainColor}"/>

                                </VisualState.Setters>

                            </VisualState>

                            <VisualState x:Name="PointerOver">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource PointColor}"/>

                                </VisualState.Setters>

                            </VisualState>

                        </VisualStateGroup>

                    </VisualStateGroupList>

                </VisualStateManager.VisualStateGroups>
                
            </Button>

            <Button Grid.Row="1" x:Name="ButtonExit" Clicked="OnExitButtonClick" Text="Отмена" TextColor="White" VerticalOptions="Center" Margin="20,10,20,20">

                <VisualStateManager.VisualStateGroups>

                    <VisualStateGroupList>

                        <VisualStateGroup x:Name="CommonStates">

                            <VisualState x:Name="Normal">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource ExitColor}"/>

                                </VisualState.Setters>

                            </VisualState>

                            <VisualState x:Name="PointerOver">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource PointExitColor}"/>

                                </VisualState.Setters>

                            </VisualState>

                        </VisualStateGroup>

                    </VisualStateGroupList>

                </VisualStateManager.VisualStateGroups>

            </Button>
        
        </Grid>

    </Grid>
    
</ContentPage>
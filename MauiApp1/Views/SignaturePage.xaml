<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiApp1.Views.SignaturePage">
    
    <VerticalStackLayout>

        <Label x:Name="Label" TextColor="White" HorizontalOptions="Center" FontSize="Title" Margin="15"/>

        <Border HeightRequest="200" WidthRequest="400">

            <Border.StrokeShape>

                <RoundRectangle CornerRadius="15"/>

            </Border.StrokeShape>
            
            <toolkit:DrawingView
            x:Name="SignaturePad"
            LineColor="Blue"
            LineWidth="4"
            BackgroundColor="White"
            HeightRequest="200"
            WidthRequest="400"
            IsMultiLineModeEnabled="True"
            Margin="10"/>

        </Border>

        <HorizontalStackLayout HorizontalOptions="Center">

            <Button Text="Очистить" TextColor="White" FontSize="Subtitle" Clicked="OnClearButtonClick" Margin="10">

                <VisualStateManager.VisualStateGroups>

                    <VisualStateGroupList>

                        <VisualStateGroup x:Name="CommonStates">

                            <VisualState x:Name="Normal">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource ExitColor}"/>

                                </VisualState.Setters>

                            </VisualState>

                            <VisualState x:Name="PointerOver">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource PointExitColor}"/>

                                </VisualState.Setters>

                            </VisualState>

                        </VisualStateGroup>

                    </VisualStateGroupList>

                </VisualStateManager.VisualStateGroups>

            </Button>

            <Button Text="Подписать" TextColor="White" FontSize="Subtitle" Clicked="OnSignButtonClick" Margin="10">

                <VisualStateManager.VisualStateGroups>

                    <VisualStateGroupList>

                        <VisualStateGroup x:Name="CommonStates">

                            <VisualState x:Name="Normal">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource MainColor}"/>

                                </VisualState.Setters>

                            </VisualState>

                            <VisualState x:Name="PointerOver">

                                <VisualState.Setters>

                                    <Setter Property="Background" Value="{DynamicResource PointMainColor}"/>

                                </VisualState.Setters>

                            </VisualState>

                        </VisualStateGroup>

                    </VisualStateGroupList>

                </VisualStateManager.VisualStateGroups>

            </Button>

        </HorizontalStackLayout>

    </VerticalStackLayout>
    
</ContentPage>
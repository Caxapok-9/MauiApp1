<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiApp1.Views.SignaturePage">
    <ScrollView>
        
        <VerticalStackLayout>

            <HorizontalStackLayout x:Name="MVP" Margin="0,10,0,10">

                <Label x:Name="LabelMVP"
                       Text="Лучший игрок соперника (Необязательно)"
                       TextColor="White"
                       FontAttributes="Bold"
                       HorizontalOptions="Start" 
                       FontSize="Subtitle" 
                       VerticalOptions="Center" 
                       Margin="25,0,25,0"/>

                <Border Stroke="{DynamicResource MainColor}" HorizontalOptions="End">

                    <Border.StrokeShape>

                        <RoundRectangle CornerRadius="5"/>

                    </Border.StrokeShape>

                    <Picker x:Name="PickerMVP" FontSize="Large" HorizontalTextAlignment="Center" ItemDisplayBinding="{Binding Number}"/>

                </Border>

            </HorizontalStackLayout>

            <Label x:Name="LabelProtest" Text="Протест" FontAttributes="Bold" FontSize="Subtitle" TextColor="White" Margin="25,10,0,10"/>
            <Border x:Name="BorderProtest" HeightRequest="150" Margin="15,0,15,0" Stroke="{DynamicResource MainColor}">

                <Border.StrokeShape>

                    <RoundRectangle CornerRadius="15"/>

                </Border.StrokeShape>

                <Editor x:Name="EditorProtest"
                        Placeholder="При отсутствии протеста оставить пустым" 
                        FontSize="Subtitle" 
                        VerticalOptions="Fill" 
                        HorizontalOptions="Fill"
                        Margin="5,0,5,0"/>

            </Border>

            <Label Text="Ваша подпись" FontAttributes="Bold" FontSize="Subtitle" TextColor="White" Margin="25,10,0,10"/>
            <Border HeightRequest="220" WidthRequest="320" HorizontalOptions="Center" Margin="15,0,15,0" Stroke="{DynamicResource MainColor}">

                <Border.StrokeShape>

                    <RoundRectangle CornerRadius="15"/>

                </Border.StrokeShape>
            
                <toolkit:DrawingView
                    x:Name="SignaturePad"
                    LineColor="Blue"
                    LineWidth="4"
                    BackgroundColor="White"
                    VerticalOptions="Fill"
                    HorizontalOptions="Fill"
                    IsMultiLineModeEnabled="True"
                    Margin="10" 
                    HeightRequest="200" 
                    WidthRequest="300"/>

            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Margin="0,10,0,10">

                <Button Text="Очистить" TextColor="White" HorizontalOptions="Center" FontSize="Subtitle" Clicked="OnClearButtonClick" Margin="0,0,10,0">

                    <VisualStateManager.VisualStateGroups>

                        <VisualStateGroupList>

                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal">

                                    <VisualState.Setters>

                                        <Setter Property="Background" Value="{DynamicResource ExitColor}"/>

                                    </VisualState.Setters>

                                </VisualState>

                                <VisualState x:Name="PointerOver">

                                    <VisualState.Setters>

                                        <Setter Property="Background" Value="{DynamicResource PointExitColor}"/>

                                    </VisualState.Setters>

                                </VisualState>

                            </VisualStateGroup>

                        </VisualStateGroupList>

                    </VisualStateManager.VisualStateGroups>

                </Button>

                <Button Text="Отменить" TextColor="White" HorizontalOptions="Center" FontSize="Subtitle" Clicked="OnCancelButtonClick" Margin="10,0,0,0">

                    <VisualStateManager.VisualStateGroups>

                        <VisualStateGroupList>

                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal">

                                    <VisualState.Setters>

                                        <Setter Property="Background" Value="{DynamicResource MainColor}"/>

                                    </VisualState.Setters>

                                </VisualState>

                                <VisualState x:Name="PointerOver">

                                    <VisualState.Setters>

                                        <Setter Property="Background" Value="{DynamicResource PointMainColor}"/>

                                    </VisualState.Setters>

                                </VisualState>

                            </VisualStateGroup>

                        </VisualStateGroupList>

                    </VisualStateManager.VisualStateGroups>

                </Button>

            </HorizontalStackLayout>

        </VerticalStackLayout>
        
    </ScrollView>

</ContentPage>